<?xml version="1.0" encoding="utf-8"?>
<!--
    مسارات مشاركة الملفات الآمنة (Secure FileProvider Paths Configuration)
    تم إزالة root-path لمنع أي وصول غير مقيد لجذر نظام الملفات،
    وحصر المشاركة في مجلدات التخزين الخاصة بالتطبيق (التقارير، النسخ الاحتياطية المشفرة، والصور).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="cache_reports" path="." />
    <files-path name="files_reports" path="." />
    <external-files-path name="external_backup_files" path="." />
    <external-cache-path name="external_cache_reports" path="." />
    <external-path name="external_files" path="." />
</paths>
